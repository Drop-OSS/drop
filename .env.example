# GameDepot Environment Configuration Example
# Copy this file to `.env` and adjust the variables to your setup.

# Database Configuration
POSTGRES_USER=gamedepot
POSTGRES_PASSWORD=gamedepot_secret_change_me
POSTGRES_DB=gamedepot
DATABASE_URL=postgresql://gamedepot:gamedepot_secret_change_me@postgres:5432/gamedepot?schema=public

# Application Ports & Host
GAMEDEPOT_PORT=3000

# Security & Secrets
# Generate random secrets for sessions and tokens: openssl rand -base64 32
JWT_SECRET=replace_with_a_secure_random_jwt_secret_key_32_chars_min
AUTH_SECRET=replace_with_a_secure_random_auth_secret_key_32_chars_min

# Storage Paths
LIBRARY_PATH=./storage/library
DATA_PATH=./storage/data
