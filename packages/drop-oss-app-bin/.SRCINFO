pkgbase = drop-oss-app-bin
	pkgdesc = The client application for the self-hosted game distribution platform GameDepot
	pkgver = DROP_PKG_VER
	pkgrel = DROP_PKG_REL
	url = https://github.com/cmspeedau/GameDepot
	arch = x86_64
	license = LicenseRef-GPL-3.0
	makedepends = libarchive
	depends = glib2
