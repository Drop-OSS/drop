{
  "app-id": "org.droposs.client",
  "runtime": "org.gnome.Platform",
  "runtime-version": "50",
  "sdk": "org.gnome.Sdk",
  "command": "drop-app",
  "finish-args": [
    "--env=DROP_SKIP_DEEP_LINK_AUTH=true",
    "--env=XDG_DATA_DIRS=/app/share:/usr/lib/extensions/vulkan/share:/usr/share:/usr/share/runtime/share:/run/host/user-share:/run/host/share:/usr/lib/pressure-vessel/overrides/share",
    "--allow=devel",
    "--allow=multiarch",
    "--share=network",
    "--share=ipc",
    "--socket=wayland",
    "--socket=fallback-x11",
    "--socket=pulseaudio",
    "--device=dri",
    "--filesystem=home",
    "--talk-name=org.freedesktop.Notifications",
    "--talk-name=org.kde.StatusNotifierWatcher",
    "--talk-name=org.freedesktop.portal.Background"
  ],
  "add-extensions": {
    "org.gnome.Platform.Compat.i386": {
      "directory": "lib/i386-linux-gnu",
      "version": "50"
    },
    "org.freedesktop.Platform.GL32": {
      "directory": "lib/i386-linux-gnu/GL",
      "version": "1.4",
      "versions": "50;50-extra;1.4",
      "subdirectories": true,
      "no-autodownload": true,
      "autodelete": false,
      "add-ld-path": "lib",
      "merge-dirs": "vulkan/icd.d;glvnd/egl_vendor.d;egl/egl_external_platform.d;OpenCL/vendors;lib/dri;lib/d3d;lib/gbm;vulkan/explicit_layer.d;vulkan/implicit_layer.d",
      "download-if": "active-gl-driver",
      "enable-if": "active-gl-driver",
      "autoprune-unless": "active-gl-driver"
    }
  },
  "modules": [
    {
      "name": "drop-app",
      "buildsystem": "simple",
      "build-commands": [
        "ar x drop.deb",
        "mkdir -p extracted && tar -xf data.tar.* -C extracted",
        "mkdir -p /app/share/icons /app/share/pixmaps",
        "install -Dm755 extracted/usr/bin/drop-app /app/bin/drop-app",
        "desktop_file=\"$(find extracted/usr/share/applications -maxdepth 1 -type f -name '*.desktop' -print -quit)\" && test -n \"$desktop_file\" && install -Dm644 \"$desktop_file\" /app/share/applications/org.droposs.client.desktop && sed -i -e 's|^Exec=.*|Exec=drop-app|' -e 's|^TryExec=.*|TryExec=drop-app|' -e 's|^Icon=.*|Icon=org.droposs.client|' /app/share/applications/org.droposs.client.desktop",
        "if [ -d extracted/usr/share/icons ]; then cp -a extracted/usr/share/icons/. /app/share/icons/; fi",
        "find /app/share/icons -type f -name 'drop-app.png' -exec sh -c 'for icon do mv \"$icon\" \"${icon%/*}/org.droposs.client.png\"; done' sh {} +",
        "if [ -d extracted/usr/share/pixmaps ]; then cp -a extracted/usr/share/pixmaps/. /app/share/pixmaps/; fi"
      ],
      "sources": [
        {
          "type": "file",
          "url": "https://github.com/Drop-OSS/drop/releases/download/DROP_RELEASE_TAG/Drop.Desktop.Client_DROP_PKG_VER_amd64.deb",
          "sha256": "DROP_DEB_SHA256",
          "only-arches": ["x86_64"],
          "dest-filename": "drop.deb"
        },
        {
          "type": "file",
          "url": "https://github.com/Drop-OSS/drop/releases/download/DROP_RELEASE_TAG/Drop.Desktop.Client_DROP_PKG_VER_arm64.deb",
          "sha256": "DROP_ARM64_DEB_SHA256",
          "only-arches": ["aarch64"],
          "dest-filename": "drop.deb"
        }
      ]
    },
    {
      "name": "umu-launcher",
      "buildsystem": "simple",
      "build-commands": [
        "install -Dm755 umu/umu-run /app/bin/umu-run",
      ],
      "sources": [
        {
          "type": "archive",
          "url": "https://github.com/Open-Wine-Components/umu-launcher/releases/download/1.4.4/umu-launcher-1.4.4-zipapp.tar",
          "sha256": "eb590691841f7fad3fc3ad8fd5db4ccb87849fe7948e62b28ece7a4ee48cc851"
        }
      ]
    }
  ]
}
